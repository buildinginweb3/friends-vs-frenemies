{
  "name": "friends-vs-frenemies",
  "version": "0.1.0",
  "private": true,
  "description": "FRIENDS vs FRENEMIES — idle PvE roguelite defense for the Rare Friends Vibeathon (FriendSDK v0.1.2).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/pnp-safe.mjs node node_modules/@rarefriends/friendsdk/scripts/dev-game.mjs dev ./games/friends-vs-frenemies",
    "dev:lan": "node scripts/pnp-safe.mjs node node_modules/@rarefriends/friendsdk/scripts/dev-game.mjs dev ./games/friends-vs-frenemies --host 0.0.0.0 --port 4173",
    "build": "node scripts/pnp-safe.mjs node node_modules/@rarefriends/friendsdk/scripts/dev-game.mjs build ./games/friends-vs-frenemies",
    "check": "node node_modules/@rarefriends/friendsdk/scripts/dev-game.mjs check ./games/friends-vs-frenemies",
    "test": "node scripts/pnp-safe.mjs node node_modules/@rarefriends/friendsdk/scripts/dev-game.mjs test ./games/friends-vs-frenemies --screenshot ./artifacts/game.png",
    "test:mobile": "node scripts/pnp-safe.mjs node node_modules/@rarefriends/friendsdk/scripts/dev-game.mjs test ./games/friends-vs-frenemies --width 360 --screenshot ./artifacts/game-mobile.png",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "logic:test": "node --test tests/logic.test.mjs",
    "pnp:restore": "node scripts/pnp-restore.mjs"
  },
  "dependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rarefriends/friendsdk": "file:./vendor/rarefriends-friendsdk-0.1.2.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
